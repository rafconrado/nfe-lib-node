{
  "name": "nfe-lib-node",
  "version": "1.2.0",
  "description": "Biblioteca Node.js para emissão, assinatura e comunicação com webservices de NF-e (SEFAZ)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "status": "node --experimental-strip-types examples/exemplo-status.ts",
    "emitir": "node --experimental-strip-types examples/exemplo-emissao.ts",
    "test": "node --experimental-strip-types examples/exemplo-emissao.ts"
  },
  "keywords": [
    "nfe",
    "sefaz",
    "xml",
    "xmldsig",
    "soap",
    "nota-fiscal"
  ],
  "author": "Rafael Conrado",
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.20.0",
    "node-forge": "^1.4.0",
    "xml-crypto": "^6.3.0",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/node-forge": "^1.3.14",
    "@types/xml-crypto": "^1.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
